# Form endpoint (Formspree or equivalent). Replace the placeholder with your real HTTPS form URL.
# Create a form at https://formspree.io and paste its endpoint here.
VITE_FORM_ENDPOINT=https://formspree.io/f/your_form_id
# Development only: simulates a submission WITHOUT sending data. Ignored in production builds.
VITE_FORM_TEST_MODE=false
